{
  "id": "/",
  "name": "Kasaba Meydanı",
  "short_name": "Kasaba Meydanı",
  "description": "Arkadaşlarınızla çevrimiçi oynamak için ücretsiz sanal kasaba meydanı ve grimuar. Topluluk yapımıdır.",
  "lang": "tr",
  "dir": "ltr",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#070a17",
  "theme_color": "#0b1026",
  "categories": ["games", "entertainment"],
  "icons": [
    { "src": "static/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "static/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "static/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "static/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "static/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    {
      "name": "Oyun aç (Anlatıcı)",
      "short_name": "Oyun aç",
      "description": "Yeni bir canlı oturum başlat",
      "url": "/?action=host",
      "icons": [{ "src": "static/shortcut-host.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Oyuna katıl (Oyuncu)",
      "short_name": "Katıl",
      "description": "Bir oturuma kanal adıyla katıl",
      "url": "/?action=join",
      "icons": [{ "src": "static/shortcut-join.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Karakter Listesi",
      "short_name": "Karakterler",
      "url": "/?action=reference",
      "icons": [{ "src": "static/shortcut-reference.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Gece Sırası",
      "short_name": "Gece",
      "url": "/?action=night",
      "icons": [{ "src": "static/shortcut-night.png", "sizes": "96x96", "type": "image/png" }]
